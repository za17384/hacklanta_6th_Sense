# Copy to .env (never commit .env). With these defaults the app runs fully
# offline: in-memory store + seeded demo crew + console messenger.

DEMO_MODE=true

# Empty → in-memory store (DEMO_MODE). Set to Tiger Cloud / local TimescaleDB to persist.
DATABASE_URL=

# photon = real iMessage via Photon Spectrum; console = fake phone panel
MESSENGER=console
# fanout = individual DMs (free shared line); group = post to crews.imessage_group_space_id (dedicated line)
CREW_MESSAGE_MODE=fanout
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

SESSION_SECRET=change-me
ADMIN_TOKEN=change-me
APP_BASE_URL=http://localhost:5173
PORT=8080

# true = API process also runs the inbound loop + reminder scheduler (dev). docker-compose sets false.
RUN_AGENT_IN_API=true

# Production only (Caddy site address), e.g. reprally.tech
DOMAIN=

# Optional LLM rewrite of message templates; templates are used when unset
LLM_PROVIDER=

SOLANA_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY=
